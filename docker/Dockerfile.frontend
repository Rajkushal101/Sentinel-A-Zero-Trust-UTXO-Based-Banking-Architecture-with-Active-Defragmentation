# Use Nginx Alpine for a tiny footprint
FROM nginx:alpine

# Remove default Nginx website
RUN rm -rf /usr/share/nginx/html/*

# Copy Frontend Files (HTML/JS)
COPY . /usr/share/nginx/html

# Note: nginx.conf is mounted as a volume via docker-compose.yml
# No need to COPY it here (it's outside the build context)

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]